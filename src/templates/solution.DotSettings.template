<wpf:ResourceDictionary xml:space="preserve" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:s="clr-namespace:System;assembly=mscorlib" xmlns:ss="urn:shemas-jetbrains-com:settings-storage-xaml" xmlns:wpf="http://schemas.microsoft.com/winfx/2006/xaml/presentation">
	<s:String x:Key="/Default/CodeStyle/CSharpFileLayoutPatterns/Pattern/@EntryValue">&lt;Patterns xmlns=&quot;urn:schemas-jetbrains-com:member-reordering-patterns&quot; StaticFieldReorderingPolicy=&quot;Strict&quot;&gt;
  &lt;!-- Preserve declaration order when it can define a contract or physical layout. --&gt;
  &lt;TypePattern DisplayName=&quot;Non-reorderable types&quot; Priority=&quot;99999999&quot;&gt;
    &lt;TypePattern.Match&gt;
      &lt;Or&gt;
        &lt;Kind Is=&quot;Interface&quot; /&gt;
        &lt;Kind Is=&quot;Enum&quot; /&gt;
        &lt;Kind Is=&quot;Delegate&quot; /&gt;
        &lt;Kind Is=&quot;Struct&quot; /&gt;
        &lt;And&gt;
          &lt;Kind Is=&quot;Record&quot; /&gt;
          &lt;InheritsFromType Name=&quot;^System\.ValueType$&quot; /&gt;
        &lt;/And&gt;
        &lt;HasAttribute Name=&quot;System.Runtime.InteropServices.StructLayoutAttribute&quot; /&gt;
        &lt;HasAttribute Name=&quot;System.Runtime.InteropServices.ExtendedLayoutAttribute&quot; /&gt;
        &lt;HasAttribute Name=&quot;JetBrains.Annotations.NoReorderAttribute&quot; /&gt;
      &lt;/Or&gt;
    &lt;/TypePattern.Match&gt;
  &lt;/TypePattern&gt;

  &lt;!-- Kind first, then explicit StyleCop accessibility order. Constants and
       fields share one kind group: accessibility precedes constant ordering.
       Remove existing regions so they cannot override global member ordering.
       Avoid extra readonly/static/name sorting and retain strict static-field
       dependency protection; unsafe types can opt out with NoReorder. --&gt;
  &lt;TypePattern DisplayName=&quot;StyleCop ordering&quot; RemoveRegions=&quot;All&quot;&gt;
    &lt;TypePattern.Match&gt;
      &lt;Or&gt;
        &lt;Kind Is=&quot;Class&quot; /&gt;
        &lt;And&gt;
          &lt;Kind Is=&quot;Record&quot; /&gt;
          &lt;Not&gt;
            &lt;InheritsFromType Name=&quot;^System\.ValueType$&quot; /&gt;
          &lt;/Not&gt;
        &lt;/And&gt;
      &lt;/Or&gt;
    &lt;/TypePattern.Match&gt;

    &lt;Entry DisplayName=&quot;Constants and fields&quot;&gt;
      &lt;Entry.Match&gt;
        &lt;Or&gt;
          &lt;Kind Is=&quot;Constant&quot; /&gt;
          &lt;Kind Is=&quot;Field&quot; /&gt;
        &lt;/Or&gt;
      &lt;/Entry.Match&gt;
      &lt;Entry.SortBy&gt;
        &lt;Access Order=&quot;Public Internal ProtectedInternal Protected PrivateProtected Private&quot; /&gt;
        &lt;Kind Order=&quot;Constant Field&quot; /&gt;
      &lt;/Entry.SortBy&gt;
    &lt;/Entry&gt;

    &lt;Entry DisplayName=&quot;Constructors&quot;&gt;
      &lt;Entry.Match&gt;
        &lt;Kind Is=&quot;Constructor&quot; /&gt;
      &lt;/Entry.Match&gt;
      &lt;Entry.SortBy&gt;
        &lt;Access Order=&quot;Public Internal ProtectedInternal Protected PrivateProtected Private&quot; /&gt;
      &lt;/Entry.SortBy&gt;
    &lt;/Entry&gt;

    &lt;Entry DisplayName=&quot;Destructor&quot;&gt;
      &lt;Entry.Match&gt;
        &lt;Kind Is=&quot;Destructor&quot; /&gt;
      &lt;/Entry.Match&gt;
    &lt;/Entry&gt;

    &lt;Entry DisplayName=&quot;Delegates&quot;&gt;
      &lt;Entry.Match&gt;
        &lt;Kind Is=&quot;Delegate&quot; /&gt;
      &lt;/Entry.Match&gt;
      &lt;Entry.SortBy&gt;
        &lt;Access Order=&quot;Public Internal ProtectedInternal Protected PrivateProtected Private&quot; /&gt;
      &lt;/Entry.SortBy&gt;
    &lt;/Entry&gt;

    &lt;Entry DisplayName=&quot;Events&quot;&gt;
      &lt;Entry.Match&gt;
        &lt;Kind Is=&quot;Event&quot; /&gt;
      &lt;/Entry.Match&gt;
      &lt;Entry.SortBy&gt;
        &lt;Access Order=&quot;Public Internal ProtectedInternal Protected PrivateProtected Private&quot; /&gt;
      &lt;/Entry.SortBy&gt;
    &lt;/Entry&gt;

    &lt;Entry DisplayName=&quot;Enums&quot;&gt;
      &lt;Entry.Match&gt;
        &lt;Kind Is=&quot;Enum&quot; /&gt;
      &lt;/Entry.Match&gt;
      &lt;Entry.SortBy&gt;
        &lt;Access Order=&quot;Public Internal ProtectedInternal Protected PrivateProtected Private&quot; /&gt;
      &lt;/Entry.SortBy&gt;
    &lt;/Entry&gt;

    &lt;Entry DisplayName=&quot;Nested interfaces&quot;&gt;
      &lt;Entry.Match&gt;
        &lt;Kind Is=&quot;Interface&quot; /&gt;
      &lt;/Entry.Match&gt;
      &lt;Entry.SortBy&gt;
        &lt;Access Order=&quot;Public Internal ProtectedInternal Protected PrivateProtected Private&quot; /&gt;
      &lt;/Entry.SortBy&gt;
    &lt;/Entry&gt;

    &lt;Entry DisplayName=&quot;Properties&quot;&gt;
      &lt;Entry.Match&gt;
        &lt;Kind Is=&quot;Property&quot; /&gt;
      &lt;/Entry.Match&gt;
      &lt;Entry.SortBy&gt;
        &lt;Access Order=&quot;Public Internal ProtectedInternal Protected PrivateProtected Private&quot; /&gt;
      &lt;/Entry.SortBy&gt;
    &lt;/Entry&gt;

    &lt;Entry DisplayName=&quot;Indexers&quot;&gt;
      &lt;Entry.Match&gt;
        &lt;Kind Is=&quot;Indexer&quot; /&gt;
      &lt;/Entry.Match&gt;
      &lt;Entry.SortBy&gt;
        &lt;Access Order=&quot;Public Internal ProtectedInternal Protected PrivateProtected Private&quot; /&gt;
      &lt;/Entry.SortBy&gt;
    &lt;/Entry&gt;

    &lt;Entry DisplayName=&quot;Operators&quot;&gt;
      &lt;Entry.Match&gt;
        &lt;Kind Is=&quot;Operator&quot; /&gt;
      &lt;/Entry.Match&gt;
      &lt;Entry.SortBy&gt;
        &lt;Access Order=&quot;Public Internal ProtectedInternal Protected PrivateProtected Private&quot; /&gt;
      &lt;/Entry.SortBy&gt;
    &lt;/Entry&gt;

    &lt;Entry DisplayName=&quot;Methods&quot;&gt;
      &lt;Entry.Match&gt;
        &lt;Kind Is=&quot;Method&quot; /&gt;
      &lt;/Entry.Match&gt;
      &lt;Entry.SortBy&gt;
        &lt;Access Order=&quot;Public Internal ProtectedInternal Protected PrivateProtected Private&quot; /&gt;
      &lt;/Entry.SortBy&gt;
    &lt;/Entry&gt;

    &lt;Entry DisplayName=&quot;Nested structs&quot;&gt;
      &lt;Entry.Match&gt;
        &lt;Or&gt;
          &lt;Kind Is=&quot;Struct&quot; /&gt;
          &lt;And&gt;
            &lt;Kind Is=&quot;Record&quot; /&gt;
            &lt;InheritsFromType Name=&quot;^System\.ValueType$&quot; /&gt;
          &lt;/And&gt;
        &lt;/Or&gt;
      &lt;/Entry.Match&gt;
      &lt;Entry.SortBy&gt;
        &lt;Access Order=&quot;Public Internal ProtectedInternal Protected PrivateProtected Private&quot; /&gt;
      &lt;/Entry.SortBy&gt;
    &lt;/Entry&gt;

    &lt;Entry DisplayName=&quot;Nested classes&quot;&gt;
      &lt;Entry.Match&gt;
        &lt;Or&gt;
          &lt;Kind Is=&quot;Class&quot; /&gt;
          &lt;And&gt;
            &lt;Kind Is=&quot;Record&quot; /&gt;
            &lt;Not&gt;
              &lt;InheritsFromType Name=&quot;^System\.ValueType$&quot; /&gt;
            &lt;/Not&gt;
          &lt;/And&gt;
        &lt;/Or&gt;
      &lt;/Entry.Match&gt;
      &lt;Entry.SortBy&gt;
        &lt;Access Order=&quot;Public Internal ProtectedInternal Protected PrivateProtected Private&quot; /&gt;
      &lt;/Entry.SortBy&gt;
    &lt;/Entry&gt;
  &lt;/TypePattern&gt;
&lt;/Patterns&gt;</s:String>
	<s:String x:Key="/Default/CodeStyle/CodeCleanup/Profiles/=ReorderOnly/@EntryIndexedValue">&lt;?xml version=&quot;1.0&quot; encoding=&quot;utf-16&quot;?&gt;
&lt;Profile name=&quot;ReorderOnly&quot;&gt;
  &lt;CSReorderTypeMembers&gt;True&lt;/CSReorderTypeMembers&gt;
&lt;/Profile&gt;</s:String>
</wpf:ResourceDictionary>
